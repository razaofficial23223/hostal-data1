import sqlite3
import pandas as pd
from datetime import date

DB_PATH = "/kaggle/working/hostel_data.db"

# 1. Add Payment
def add_payment(student_name, amount, payment_date,
                payment_method, status="Paid",
                description=""):

    if not student_name.strip():
        print("Student name is required!")
        return

    if amount <= 0:
        print("Amount must be greater than zero!")
        return

    if status not in ["Paid", "Pending"]:
        print("Invalid payment status!")
        return

    conn = sqlite3.connect(DB_PATH)

    # Find student ID if registered
    student = conn.execute(
        "SELECT id FROM students WHERE student_name=? LIMIT 1",
        (student_name,)
    ).fetchone()

    student_id = student[0] if student else None

    conn.execute("""
        INSERT INTO payments
        (student_id, student_name, amount, payment_date,
         payment_method, status, description)
        VALUES (?, ?, ?, ?, ?, ?, ?)
    """, (
        student_id,
        student_name,
        amount,
        str(payment_date),
        payment_method,
        status,
        description
    ))

    conn.commit()
    conn.close()

    print("Payment record saved successfully!")


# 2. View All Payments
def view_payments():

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query("""
        SELECT * FROM payments
        ORDER BY payment_date DESC, id DESC
    """, conn)

    conn.close()
    return df


# 3. Total Paid Income
def total_income():

    conn = sqlite3.connect(DB_PATH)

    total = conn.execute("""
        SELECT COALESCE(SUM(amount), 0)
        FROM payments
        WHERE status='Paid'
    """).fetchone()[0]

    conn.close()
    return total


# 4. Total Pending Payments
def pending_payments():

    conn = sqlite3.connect(DB_PATH)

    total = conn.execute("""
        SELECT COALESCE(SUM(amount), 0)
        FROM payments
        WHERE status='Pending'
    """).fetchone()[0]

    conn.close()
    return total


# 5. Update Payment Status
def update_payment_status(payment_id, new_status):

    if new_status not in ["Paid", "Pending"]:
        print("Invalid status!")
        return

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute("""
        UPDATE payments
        SET status=?
        WHERE id=?
    """, (new_status, payment_id))

    conn.commit()

    if cursor.rowcount:
        print("Payment status updated!")
    else:
        print("Payment ID not found!")

    conn.close()


# 6. Delete Payment
def delete_payment(payment_id):

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute(
        "DELETE FROM payments WHERE id=?",
        (payment_id,)
    )

    conn.commit()

    if cursor.rowcount:
        print("Payment deleted successfully!")
    else:
        print("Payment ID not found!")

    conn.close()


# 7. Payment Summary
print("HOSTEL PAYMENT MANAGEMENT READY!")

