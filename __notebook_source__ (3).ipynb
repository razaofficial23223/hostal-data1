import sqlite3
import pandas as pd
import plotly.express as px
from datetime import date
from IPython.display import display

DB_PATH = "/kaggle/working/hostel_data.db"

def get_dashboard_data():

    conn = sqlite3.connect(DB_PATH)

    data = {}

    data["students"] = conn.execute(
        "SELECT COUNT(*) FROM students"
    ).fetchone()[0]

    data["rooms"] = conn.execute(
        "SELECT COUNT(*) FROM rooms"
    ).fetchone()[0]

    data["available"] = conn.execute(
        "SELECT COUNT(*) FROM rooms WHERE status='Available'"
    ).fetchone()[0]

    data["occupied"] = conn.execute(
        "SELECT COUNT(*) FROM rooms WHERE status='Occupied'"
    ).fetchone()[0]

    data["income"] = conn.execute("""
        SELECT COALESCE(SUM(amount),0)
        FROM payments WHERE status='Paid'
    """).fetchone()[0]

    data["pending"] = conn.execute("""
        SELECT COALESCE(SUM(amount),0)
        FROM payments WHERE status='Pending'
    """).fetchone()[0]

    data["expenses"] = conn.execute("""
        SELECT COALESCE(SUM(amount),0)
        FROM expenses
    """).fetchone()[0]

    data["food"] = conn.execute("""
        SELECT COALESCE(SUM(amount),0)
        FROM food_records
    """).fetchone()[0]

    conn.close()

    data["balance"] = data["income"] - data["expenses"] - data["food"]

    return data


# Get Dashboard Information
dashboard = get_dashboard_data()

print("=" * 50)
print("       SMART HOSTEL MANAGEMENT DASHBOARD")
print("=" * 50)

print("\nTOTAL STUDENTS:", dashboard["students"])
print("TOTAL ROOMS:", dashboard["rooms"])
print("AVAILABLE ROOMS:", dashboard["available"])
print("OCCUPIED ROOMS:", dashboard["occupied"])

print("\nTOTAL INCOME: PKR", dashboard["income"])
print("TOTAL EXPENSES: PKR", dashboard["expenses"])
print("FOOD EXPENSES: PKR", dashboard["food"])
print("PENDING PAYMENTS: PKR", dashboard["pending"])
print("REMAINING BALANCE: PKR", dashboard["balance"])


