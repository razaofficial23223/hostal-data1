import sqlite3
import pandas as pd
from datetime import date

DB_PATH = "/kaggle/working/hostel_data.db"

# Expense Categories
EXPENSE_CATEGORIES = [
    "Hostel Rent",
    "Hostel Food",
    "Electricity Bill",
    "Water Bill",
    "Gas Bill",
    "Internet Bill",
    "Cleaning",
    "Maintenance",
    "Personal Expenses",
    "Other Expenses"
]

# 1. Add Expense
def add_expense(category, amount, description, expense_date):

    if category not in EXPENSE_CATEGORIES:
        print("Invalid expense category!")
        return

    if amount <= 0:
        print("Amount must be greater than zero!")
        return

    conn = sqlite3.connect(DB_PATH)

    conn.execute("""
        INSERT INTO expenses
        (category, amount, description, expense_date)
        VALUES (?, ?, ?, ?)
    """, (category, amount, description, str(expense_date)))

    conn.commit()
    conn.close()

    print("Expense saved successfully!")


# 2. View All Expenses
def view_expenses():

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query("""
        SELECT * FROM expenses
        ORDER BY expense_date DESC, id DESC
    """, conn)

    conn.close()
    return df


# 3. Monthly Expense Summary
def monthly_expense_summary(month):

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query("""
        SELECT category,
               SUM(amount) AS total_amount,
               COUNT(*) AS transactions
        FROM expenses
        WHERE substr(expense_date, 1, 7) = ?
        GROUP BY category
    """, conn, params=(month,))

    conn.close()
    return df


# 4. Delete Expense
def delete_expense(expense_id):

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute(
        "DELETE FROM expenses WHERE id=?",
        (expense_id,)
    )

    conn.commit()

    if cursor.rowcount > 0:
        print("Expense deleted successfully!")
    else:
        print("Expense ID not found!")

    conn.close()


# 5. Total Expenses
def total_expenses():

    conn = sqlite3.connect(DB_PATH)

    total = conn.execute(
        "SELECT COALESCE(SUM(amount), 0) FROM expenses"
    ).fetchone()[0]

    conn.close()

    return total


print("HOSTEL EXPENSE MANAGEMENT SYSTEM READY!")
print("Total Expenses: PKR", total_expenses())

display(view_expenses())




# Add test expenses

add_expense(
    "Hostel Food",
    5000,
    "Monthly Hostel Food",
    date.today()
)

add_expense(
    "Electricity Bill",
    2000,
    "Monthly Electricity",
    date.today()
)

# Display all expenses
print("\nALL EXPENSES")

display(view_expenses())

# Monthly Summary
current_month = date.today().strftime("%Y-%m")

print("\nMONTHLY EXPENSE SUMMARY")

display(monthly_expense_summary(current_month))

print("TOTAL EXPENSES: PKR", total_expenses())




