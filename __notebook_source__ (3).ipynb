import sqlite3
import os

# Database location
DB_PATH = "/kaggle/working/hostel_data.db"

# Database connection
def get_connection():
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA foreign_keys = ON")
    return conn

# Create database tables
def initialize_database():

    conn = get_connection()
    cursor = conn.cursor()

    # 1. Students Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS students (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        student_name TEXT NOT NULL,
        father_name TEXT,
        phone TEXT,
        cnic TEXT,
        university TEXT,
        room_number TEXT,
        admission_date TEXT,
        monthly_rent REAL DEFAULT 0,
        emergency_contact TEXT,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
    """)

    # 2. Rooms Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS rooms (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        room_number TEXT UNIQUE NOT NULL,
        capacity INTEGER DEFAULT 1,
        monthly_rent REAL DEFAULT 0,
        status TEXT DEFAULT 'Available'
    )
    """)

    # 3. Expenses Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS expenses (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        category TEXT NOT NULL,
        amount REAL NOT NULL,
        description TEXT,
        expense_date TEXT NOT NULL,
        created_at TEXT DEFAULT CURRENT_TIMESTAMP
    )
    """)

    # 4. Payments Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS payments (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        student_id INTEGER,
        student_name TEXT,
        amount REAL NOT NULL,
        payment_date TEXT NOT NULL,
        payment_method TEXT,
        status TEXT DEFAULT 'Paid',
        description TEXT,
        FOREIGN KEY(student_id) REFERENCES students(id)
    )
    """)

    # 5. Food Records Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS food_records (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        food_type TEXT NOT NULL,
        amount REAL NOT NULL,
        description TEXT,
        food_date TEXT NOT NULL
    )
    """)

    # 6. Monthly Budget Table
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS budgets (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        month TEXT UNIQUE NOT NULL,
        budget_amount REAL DEFAULT 30000
    )
    """)

    conn.commit()
    conn.close()

    print("Database created successfully!")

# Initialize database
initialize_database()

# Check database
conn = get_connection()

tables = conn.execute("""
SELECT name FROM sqlite_master
WHERE type='table'
ORDER BY name
""").fetchall()

print("\nDatabase Tables:")

for table in tables:
    print("✅", table[0])

conn.close()

print("\nDatabase Location:", DB_PATH)
print("Smart Hostel Database is Ready!")




import sqlite3
import pandas as pd

DB_PATH = "/kaggle/working/hostel_data.db"

# 1. Add Student
def add_student(name, father, phone, cnic, university,
                room, admission, rent, emergency):

    conn = sqlite3.connect(DB_PATH)

    conn.execute("""
    INSERT INTO students
    (student_name, father_name, phone, cnic, university,
     room_number, admission_date, monthly_rent, emergency_contact)
    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (name, father, phone, cnic, university,
          room, admission, rent, emergency))

    conn.commit()
    conn.close()

    print("Student saved successfully!")


# 2. View All Students
def view_students():

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query(
        "SELECT * FROM students ORDER BY id DESC", conn
    )

    conn.close()

    return df


# 3. Search Student
def search_student(keyword):

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query("""
    SELECT * FROM students
    WHERE student_name LIKE ?
    OR cnic LIKE ?
    OR phone LIKE ?
    """, conn, params=(
        f"%{keyword}%",
        f"%{keyword}%",
        f"%{keyword}%"
    ))

    conn.close()

    return df


# 4. Update Student
def update_student(student_id, name, phone, room, rent):

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute("""
    UPDATE students
    SET student_name=?, phone=?, room_number=?, monthly_rent=?
    WHERE id=?
    """, (name, phone, room, rent, student_id))

    conn.commit()
    updated = cursor.rowcount
    conn.close()

    print("Student updated!" if updated else "Student ID not found!")


# 5. Delete Student
def delete_student(student_id):

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute(
        "DELETE FROM students WHERE id=?",
        (student_id,)
    )

    conn.commit()
    deleted = cursor.rowcount
    conn.close()

    print("Student deleted!" if deleted else "Student ID not found!")


