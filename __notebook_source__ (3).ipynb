import sqlite3
import pandas as pd

DB_PATH = "/kaggle/working/hostel_data.db"

# Add New Room
def add_room(room_number, capacity, rent):

    conn = sqlite3.connect(DB_PATH)

    try:
        conn.execute("""
            INSERT INTO rooms
            (room_number, capacity, monthly_rent, status)
            VALUES (?, ?, ?, 'Available')
        """, (room_number, capacity, rent))

        conn.commit()
        print("Room added successfully!")

    except sqlite3.IntegrityError:
        print("Error: This room number already exists!")

    finally:
        conn.close()


# View All Rooms
def view_rooms():

    conn = sqlite3.connect(DB_PATH)

    df = pd.read_sql_query("""
        SELECT * FROM rooms ORDER BY room_number
    """, conn)

    conn.close()
    return df


# Delete Room
def delete_room(room_id):

    conn = sqlite3.connect(DB_PATH)

    cursor = conn.execute(
        "DELETE FROM rooms WHERE id = ?",
        (room_id,)
    )

    conn.commit()

    if cursor.rowcount:
        print("Room deleted successfully!")
    else:
        print("Room ID not found!")

    conn.close()


# Room Statistics
def room_statistics():

    conn = sqlite3.connect(DB_PATH)

    total = pd.read_sql_query(
        "SELECT COUNT(*) AS total FROM rooms", conn
    ).iloc[0, 0]

    available = pd.read_sql_query(
        "SELECT COUNT(*) AS total FROM rooms WHERE status='Available'",
        conn
    ).iloc[0, 0]

    occupied = pd.read_sql_query(
        "SELECT COUNT(*) AS total FROM rooms WHERE status='Occupied'",
        conn
    ).iloc[0, 0]

    conn.close()

    print("Total Rooms:", total)
    print("Available Rooms:", available)
    print("Occupied Rooms:", occupied)


